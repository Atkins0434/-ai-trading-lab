{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "end_of_day_outcome.schema.json",
  "title": "End of Day Outcome",
  "description": "Observed intraday outcome and deterministic execution result for a Scout candidate during historical replay.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "replay_id",
    "trading_date",
    "scout_version",
    "execution_policy_version",
    "massive_plan",
    "universe_mode",
    "universe_manifest_hash",
    "universe_coverage",
    "research_evidence",
    "promotion_eligible",
    "outcomes",
    "policy_comparisons"
  ],

  "properties": {
    "replay_id": {
      "type": "string"
    },

    "trading_date": {
      "type": "string",
      "format": "date"
    },

    "scout_version": {
      "type": "string"
    },

    "execution_policy_version": {
      "type": "string"
    },

    "massive_plan": {"$ref": "#/$defs/massivePlan"},

    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "universe_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "universe_coverage": {"enum": ["complete", "incomplete", "fixture"]},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},

    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/securityOutcome"
      }
    },

    "policy_comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/policyComparison"}
    },
    "cost_model_id": {"type": ["string", "null"]}
  },

  "$defs": {
    "massivePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "securityOutcome": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "ticker",
        "selected",
        "selection_basis",
        "intraday_path",
        "mfe_pct",
        "mae_pct",
        "execution_result"
      ],

      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },

        "selected": {
          "type": "boolean"
        },

        "selection_basis": {
          "enum": [
            "QUALIFYING_THRESHOLD",
            "EXPLORATION_TOP_K",
            "REVERSAL_EXPLORATION",
            "NOT_SELECTED"
          ]
        },

        "scout_rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "scout_score_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },

        "intraday_path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bar"
          }
        },

        "mfe_pct": {
          "type": "number"
        },

        "mae_pct": {
          "type": "number"
        },

        "day_mfe_pct": {"type": "number"},

        "day_mae_pct": {"type": "number"},

        "execution_exclusion_reason": {
          "type": ["string", "null"],
          "enum": ["BAR_DISCONTINUITY", null]
        },

        "maximum_capturable_move_pct": {
          "type": [
            "number",
            "null"
          ]
        },

        "execution_result": {
          "$ref": "#/$defs/executionResult"
        }
      }
    },

    "bar": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],

      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "open": {
          "type": "number",
          "minimum": 0
        },

        "high": {
          "type": "number",
          "minimum": 0
        },

        "low": {
          "type": "number",
          "minimum": 0
        },

        "close": {
          "type": "number",
          "minimum": 0
        },

        "volume": {
          "type": "number",
          "minimum": 0
        },

        "session": {
          "type": "string"
        },

        "source": {
          "type": "string"
        }
      }
    },

    "executionResult": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "trade_executed",
        "realized_return_pct",
        "policy_id",
        "exit_mode",
        "sizing_mode",
        "stop_distance_usd",
        "stop_distance_pct",
        "target_distance_usd",
        "target_distance_pct",
        "risk_usd_at_entry",
        "entry_rejection_reason"
      ],

      "properties": {
        "trade_executed": {
          "type": "boolean"
        },

        "entry_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "entry_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "position_size_shares": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "position_value_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "exit_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "exit_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "exit_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ABNORMAL_PUT_VOLUME",
            "TRAILING_STOP",
            "PROFIT_TARGET",
            "MIDDAY_LIQUIDATION",
            "SESSION_END",
            "ENTRY_REJECTED",
            "NO_REGULAR_SESSION_PATH",
            "BAR_DISCONTINUITY",
            null
          ]
        },

        "realized_pnl_usd": {
          "type": [
            "number",
            "null"
          ]
        },

        "realized_return_pct": {
          "type": "number"
        },

        "capture_ratio": {
          "type": [
            "number",
            "null"
          ]
        },

        "mfe_pct": {"type": ["number", "null"]},

        "mae_pct": {"type": ["number", "null"]},

        "maximum_position_drawdown_pct": {
          "type": [
            "number",
            "null"
          ]
        },

        "policy_id": {"type": "string", "minLength": 1},
        "exit_mode": {"enum": ["PERCENT", "ATR"]},
        "sizing_mode": {"enum": ["FIXED_FRACTION", "RISK_PER_TRADE"]},
        "stop_distance_usd": {"type": ["number", "null"], "minimum": 0},
        "stop_distance_pct": {"type": ["number", "null"], "minimum": 0},
        "target_distance_usd": {"type": ["number", "null"], "minimum": 0},
        "target_distance_pct": {"type": ["number", "null"], "minimum": 0},
        "risk_usd_at_entry": {"type": ["number", "null"], "minimum": 0},
        "entry_rejection_reason": {
          "type": ["string", "null"],
          "enum": [
            "ATR_UNAVAILABLE",
            "POSITION_TOO_SMALL",
            "MAX_POSITIONS_REACHED",
            null
          ]
        },
        "net_realized_return_pct": {"type": ["number", "null"]},
        "net_realized_pnl_usd": {"type": ["number", "null"]},
        "net_average_capture_ratio": {"type": ["number", "null"]},
        "gross_realized_pnl_usd": {"type": ["number", "null"]},
        "gross_realized_return_pct": {"type": ["number", "null"]},
        "entry_slippage_usd": {"type": ["number", "null"]},
        "exit_slippage_usd": {"type": ["number", "null"]},
        "commissions_usd": {"type": ["number", "null"]},
        "regulatory_fees_usd": {"type": ["number", "null"]},
        "total_cost_usd": {"type": ["number", "null"]},
        "cost_bps_of_position": {"type": ["number", "null"]},
        "net_capture_ratio": {"type": ["number", "null"]},
        "cost_model_id": {"type": ["string", "null"]}
      }
    },

    "policyComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "exit_mode", "sizing_mode", "executions", "summary"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "exit_mode": {"enum": ["PERCENT", "ATR"]},
        "sizing_mode": {"enum": ["FIXED_FRACTION", "RISK_PER_TRADE"]},
        "executions": {
          "type": "array",
          "items": {"$ref": "#/$defs/comparisonExecution"}
        },
        "summary": {"$ref": "#/$defs/policySummary"},
        "return_baselines": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/returnBaselines"}]}
      }
    },

    "comparisonExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker", "cohort", "benchmark_rank", "execution_result"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "cohort": {"enum": ["SCOUT_SELECTION", "TOP_10_MOVER"]},
        "benchmark_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
        "execution_result": {"$ref": "#/$defs/executionResult"}
      }
    },

    "policySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net_realized_pnl_usd", "realized_return_pct", "win_rate_pct",
        "average_winner_pct", "average_loser_pct", "average_capture_ratio",
        "max_drawdown_pct", "exit_reason_counts"
      ],
      "properties": {
        "net_realized_pnl_usd": {"type": ["number", "null"]},
        "realized_return_pct": {"type": "number"},
        "win_rate_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "average_winner_pct": {"type": ["number", "null"]},
        "average_loser_pct": {"type": ["number", "null"]},
        "average_capture_ratio": {"type": ["number", "null"]},
        "max_drawdown_pct": {"type": ["number", "null"]},
        "exit_reason_counts": {"$ref": "#/$defs/exitReasonCounts"},
        "net_realized_return_pct": {"type": ["number", "null"]},
        "net_average_capture_ratio": {"type": ["number", "null"]},
        "realized_pnl_usd": {"type": ["number", "null"]},
        "gross_realized_pnl_usd": {"type": ["number", "null"]}
      }
    },

    "exitReasonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TRAILING_STOP", "PROFIT_TARGET", "SESSION_END", "ENTRY_REJECTED"
      ],
      "properties": {
        "TRAILING_STOP": {"type": "integer", "minimum": 0},
        "PROFIT_TARGET": {"type": "integer", "minimum": 0},
        "SESSION_END": {"type": "integer", "minimum": 0},
        "ENTRY_REJECTED": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "returnBaselines": {"type": "object", "additionalProperties": false, "required": ["return_basis", "eligible_ticker_count", "eligible_single_position_mean_return_pct", "eligible_ticker_mean_realized_pnl_usd", "eligible_basket_expected_return_pct", "eligible_basket_expected_pnl_usd", "random_draw_count", "random_draw_size", "random_seed", "random_draw_mean_realized_return_pct", "random_draw_mean_realized_pnl_usd"], "properties": {"return_basis": {"const": "GROSS_STRATEGY_RETURN_PCT"}, "eligible_ticker_count": {"type": "integer", "minimum": 0}, "eligible_single_position_mean_return_pct": {"type": "number"}, "eligible_ticker_mean_realized_pnl_usd": {"type": "number"}, "eligible_basket_expected_return_pct": {"type": "number"}, "eligible_basket_expected_pnl_usd": {"type": "number"}, "random_draw_count": {"const": 200}, "random_draw_size": {"type": "integer", "minimum": 0}, "random_seed": {"type": "integer"}, "random_draw_mean_realized_return_pct": {"type": "number"}, "random_draw_mean_realized_pnl_usd": {"type": "number"}, "net_eligible_single_position_mean_return_pct": {"type": "number"}, "net_eligible_ticker_mean_realized_pnl_usd": {"type": "number"}, "net_eligible_basket_expected_return_pct": {"type": "number"}, "net_eligible_basket_expected_pnl_usd": {"type": "number"}, "net_random_draw_mean_realized_return_pct": {"type": "number"}, "net_random_draw_mean_realized_pnl_usd": {"type": "number"}, "cost_model_id": {"type": "string"}}}
  }
}
