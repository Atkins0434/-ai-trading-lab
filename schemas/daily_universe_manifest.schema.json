{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily_universe_manifest.schema.json",
  "title": "Immutable Daily Point-in-Time Universe Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "replay_id", "trading_date", "information_cutoff", "timezone", "universe_mode", "massive_plan", "ruleset", "source", "coverage_status", "coverage_reasons", "securities", "eligible_symbol_count", "excluded_symbol_count", "manifest_hash", "research_evidence", "promotion_eligible"],
  "properties": {
    "version": {"const": "daily_universe_manifest_v1.0"},
    "replay_id": {"type": "string", "minLength": 1},
    "trading_date": {"type": "string", "format": "date"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "timezone": {"const": "America/New_York"},
    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "massive_plan": {"$ref": "#/$defs/massivePlan"},
    "ruleset": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider", "feed_version", "query_parameters", "retrieved_at"], "properties": {"provider": {"type": "string"}, "feed_version": {"type": "string"}, "query_parameters": {"type": "object"}, "retrieved_at": {"type": "string", "format": "date-time"}}},
    "coverage_status": {"enum": ["complete", "incomplete", "fixture"]},
    "coverage_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "securities": {"type": "array", "items": {"$ref": "#/$defs/security"}},
    "eligible_symbol_count": {"type": "integer", "minimum": 0},
    "excluded_symbol_count": {"type": "integer", "minimum": 0},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"}
  },
  "$defs": {
    "massivePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_security_id", "ticker", "listing_venue", "security_type", "listing_date", "delisting_date", "inclusion", "reason_codes"],
      "properties": {
        "stable_security_id": {"type": "string", "minLength": 1},
        "ticker": {"type": "string"},
        "listing_venue": {"type": "string"},
        "security_type": {"type": "string"},
        "listing_date": {"type": ["string", "null"], "format": "date"},
        "delisting_date": {"type": ["string", "null"], "format": "date"},
        "reference_data_as_of_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "market_cap_as_of_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "shares_outstanding": {"type": ["number", "null"], "minimum": 0},
        "shares_outstanding_available_at": {"type": ["string", "null"], "format": "date-time"},
        "prior_close": {"type": ["number", "null"], "minimum": 0},
        "prior_close_as_of_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "market_cap_usd": {"type": ["number", "null"], "minimum": 0},
        "inclusion": {"type": "boolean"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
