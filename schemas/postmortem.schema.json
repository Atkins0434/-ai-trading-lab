{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "postmortem.schema.json",
  "title": "Scout Trainer Postmortem",
  "description": "Return-baseline verdict and independent top-10 miss diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_id", "trading_date", "scout_version", "trainer_version",
    "execution_policy_version", "massive_plan", "universe_mode", "universe_manifest_hash",
    "universe_coverage", "research_evidence", "promotion_eligible", "result",
    "scout_performance", "benchmark_performance", "unreachable_mover_count",
    "unreachable_pct", "universe_scorability", "reachability", "shadow_scores",
    "missed_opportunities", "execution_policy_review",
    "execution_policy_verdict",
    "feature_failures", "feature_proposals"
  ],
  "properties": {
    "replay_id": {"type": "string"},
    "trading_date": {"type": "string", "format": "date"},
    "scout_version": {"type": "string"},
    "trainer_version": {"type": "string"},
    "execution_policy_version": {"type": "string"},
    "massive_plan": {"$ref": "#/$defs/massivePlan"},
    "universe_mode": {"const": "historical_research"},
    "universe_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "universe_coverage": {"const": "complete"},
    "research_evidence": {"const": true},
    "promotion_eligible": {"type": "boolean"},
    "result": {"enum": ["WIN", "TIE", "MISS"]},
    "scout_performance": {"$ref": "#/$defs/performance"},
    "benchmark_performance": {"$ref": "#/$defs/performance"},
    "unreachable_mover_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "unreachable_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "universe_scorability": {"$ref": "#/$defs/universeScorability"},
    "reachability": {"$ref": "#/$defs/reachability"},
    "shadow_scores": {
      "type": "array", "items": {"$ref": "#/$defs/shadowScore"}
    },
    "missed_opportunities": {
      "type": "array", "items": {"$ref": "#/$defs/missedOpportunity"}
    },
    "execution_policy_review": {
      "type": "array", "items": {"$ref": "#/$defs/executionReview"}
    },
    "execution_policy_verdict": {"$ref": "#/$defs/executionPolicyVerdict"},
    "feature_failures": {
      "type": "array", "items": {"$ref": "#/$defs/featureFailure"}
    },
    "feature_proposals": {
      "type": "array", "items": {"$ref": "#/$defs/featureProposalReference"}
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "massivePlan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "nullableNumber": {"type": ["number", "null"]},
    "nullableString": {"type": ["string", "null"]},
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "realized_return_pct", "realized_pnl_usd", "max_drawdown_pct",
        "win_rate_pct", "average_capture_ratio"
      ],
      "properties": {
        "realized_return_pct": {"type": "number"},
        "realized_pnl_usd": {"type": "number"},
        "max_drawdown_pct": {"$ref": "#/$defs/nullableNumber"},
        "win_rate_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "average_capture_ratio": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "componentScore": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "score", "raw_value"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "raw_value": {}
      }
    },
    "missedOpportunity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ticker", "benchmark_rank", "was_in_scout_output", "scout_selected",
        "scout_score_pct", "miss_classification", "failure_reason_codes",
        "component_scores", "realized_benchmark_return_pct",
        "realized_benchmark_pnl_usd", "scout_realized_return_pct",
        "maximum_capturable_move_pct", "scout_exit_reason",
        "premarket_real_bars_60m", "premarket_real_bars_total", "opening_range"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "benchmark_rank": {"type": "integer", "minimum": 1, "maximum": 10},
        "was_in_scout_output": {"type": "boolean"},
        "scout_selected": {"type": "boolean"},
        "scout_score_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "miss_classification": {
          "enum": [
            "NOT_IN_UNIVERSE", "INVISIBLE_AT_FREEZE", "VISIBLE_SCORED_LOW",
            "VISIBLE_GUARDRAIL_REJECTED", "PICKED_EXECUTION_LOSS", "UNCLASSIFIED"
          ]
        },
        "failure_reason_codes": {
          "type": "array", "uniqueItems": true, "items": {"type": "string"}
        },
        "component_scores": {
          "type": "array", "items": {"$ref": "#/$defs/componentScore"}
        },
        "realized_benchmark_return_pct": {"$ref": "#/$defs/nullableNumber"},
        "realized_benchmark_pnl_usd": {"$ref": "#/$defs/nullableNumber"},
        "scout_realized_return_pct": {"$ref": "#/$defs/nullableNumber"},
        "maximum_capturable_move_pct": {"type": "number"},
        "scout_exit_reason": {"$ref": "#/$defs/nullableString"},
        "premarket_real_bars_60m": {"type": "integer", "minimum": 0},
        "premarket_real_bars_total": {"type": "integer", "minimum": 0},
        "opening_range": {"$ref": "#/$defs/openingRange"}
      }
    },
    "openingRange": {
      "type": "object", "additionalProperties": false,
      "required": [
        "return_0930_0945_pct", "return_0930_1000_pct", "volume_0930_1000",
        "high_0930_1000_pct", "time_first_crossed_plus_5pct", "day_high_timestamp"
      ],
      "properties": {
        "return_0930_0945_pct": {"$ref": "#/$defs/nullableNumber"},
        "return_0930_1000_pct": {"$ref": "#/$defs/nullableNumber"},
        "volume_0930_1000": {"$ref": "#/$defs/nullableNumber"},
        "high_0930_1000_pct": {"$ref": "#/$defs/nullableNumber"},
        "time_first_crossed_plus_5pct": {"$ref": "#/$defs/nullableString"},
        "day_high_timestamp": {"$ref": "#/$defs/nullableString"}
      }
    },
    "shadowScore": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "benchmark_rank", "score_pct", "premarket_real_bars_60m"],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "benchmark_rank": {"type": "integer", "minimum": 1, "maximum": 10},
        "score_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "premarket_real_bars_60m": {"type": "integer", "minimum": 0}
      }
    },
    "executionReview": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["policy_id", "exit_mode", "sizing_mode", "cohort_summaries"],
          "properties": {
            "policy_id": {"type": "string", "minLength": 1},
            "exit_mode": {"enum": ["PERCENT", "ATR"]},
            "sizing_mode": {"enum": ["FIXED_FRACTION", "RISK_PER_TRADE"]},
            "cohort_summaries": {
              "type": "object", "additionalProperties": false,
              "required": ["SCOUT_SELECTION", "TOP_10_MOVER"],
              "properties": {
                "SCOUT_SELECTION": {"$ref": "#/$defs/cohortSummary"},
                "TOP_10_MOVER": {"$ref": "#/$defs/cohortSummary"}
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["ticker", "benchmark_rank", "realized_return_pct", "maximum_capturable_move_pct", "exit_reason", "reason_codes"],
          "properties": {
            "ticker": {"type": "string"},
            "benchmark_rank": {"type": "integer", "minimum": 1, "maximum": 10},
            "realized_return_pct": {"$ref": "#/$defs/nullableNumber"},
            "maximum_capturable_move_pct": {"type": "number"},
            "exit_reason": {"$ref": "#/$defs/nullableString"},
            "reason_codes": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "cohortSummary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "trades_executed", "realized_return_pct", "net_realized_pnl_usd",
        "average_capture_ratio", "win_rate_pct", "max_drawdown_pct",
        "exit_reason_counts", "delta_vs_champion"
      ],
      "properties": {
        "trades_executed": {"type": "integer", "minimum": 0},
        "realized_return_pct": {"type": "number"},
        "net_realized_pnl_usd": {"type": "number"},
        "average_capture_ratio": {"$ref": "#/$defs/nullableNumber"},
        "win_rate_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "max_drawdown_pct": {"$ref": "#/$defs/nullableNumber"},
        "exit_reason_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["TRAILING_STOP", "PROFIT_TARGET", "SESSION_END", "ENTRY_REJECTED"],
          "properties": {
            "TRAILING_STOP": {"type": "integer", "minimum": 0},
            "PROFIT_TARGET": {"type": "integer", "minimum": 0},
            "SESSION_END": {"type": "integer", "minimum": 0},
            "ENTRY_REJECTED": {
              "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
            }
          }
        },
        "delta_vs_champion": {
          "type": "object", "additionalProperties": false,
          "required": ["return_pct", "capture_ratio"],
          "properties": {
            "return_pct": {"$ref": "#/$defs/nullableNumber"},
            "capture_ratio": {"$ref": "#/$defs/nullableNumber"}
          }
        }
      }
    },
    "executionPolicyVerdict": {
      "type": "object", "additionalProperties": false,
      "required": [
        "champion_policy_id", "best_challenger_policy_id",
        "challenger_won_on_selection", "challenger_won_on_movers", "sample_size"
      ],
      "properties": {
        "champion_policy_id": {"type": "string", "minLength": 1},
        "best_challenger_policy_id": {"type": ["string", "null"]},
        "challenger_won_on_selection": {"type": "boolean"},
        "challenger_won_on_movers": {"type": "boolean"},
        "sample_size": {
          "type": "object", "additionalProperties": false,
          "required": ["SCOUT_SELECTION", "TOP_10_MOVER"],
          "properties": {
            "SCOUT_SELECTION": {"type": "integer", "minimum": 0},
            "TOP_10_MOVER": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "universeScorability": {
      "type": "object", "additionalProperties": false,
      "required": [
        "eligible_count", "scorable_count", "not_scorable_share",
        "zero_premarket_bar_count", "zero_premarket_60m_bar_count",
        "top_10_invisible_count"
      ],
      "properties": {
        "eligible_count": {"type": "integer", "minimum": 0},
        "scorable_count": {"type": "integer", "minimum": 0},
        "not_scorable_share": {"type": "number", "minimum": 0, "maximum": 1},
        "zero_premarket_bar_count": {"type": "integer", "minimum": 0},
        "zero_premarket_60m_bar_count": {"type": "integer", "minimum": 0},
        "top_10_invisible_count": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "reachability": {
      "type": "object", "additionalProperties": false,
      "required": [
        "bars_0", "bars_1_9", "bars_10_29", "visible_scored_low",
        "visible_guardrail_rejected", "picked", "opening_range_reachable_count"
      ],
      "properties": {
        "bars_0": {"type": "integer", "minimum": 0, "maximum": 10},
        "bars_1_9": {"type": "integer", "minimum": 0, "maximum": 10},
        "bars_10_29": {"type": "integer", "minimum": 0, "maximum": 10},
        "visible_scored_low": {"type": "integer", "minimum": 0, "maximum": 10},
        "visible_guardrail_rejected": {"type": "integer", "minimum": 0, "maximum": 10},
        "picked": {"type": "integer", "minimum": 0, "maximum": 10},
        "opening_range_reachable_count": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "featureFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "failure_type"],
      "properties": {
        "feature_id": {"type": "string"},
        "failure_type": {
          "enum": [
            "THRESHOLD", "INTERACTION", "REDUNDANCY", "DOUBLE_COUNTING",
            "CANCELLATION", "MISSING_DATA", "MISSING_FEATURE", "WEIGHTING", "OTHER"
          ]
        },
        "description": {"$ref": "#/$defs/nullableString"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "featureProposalReference": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "proposal_type", "status"],
      "properties": {
        "proposal_id": {"type": "string"},
        "proposal_type": {
          "enum": [
            "NEW_FEATURE", "THRESHOLD_CHANGE", "WEIGHT_CHANGE",
            "FEATURE_INTERACTION", "COMPOSITE_FEATURE", "GUARDRAIL_CHANGE"
          ]
        },
        "status": {"const": "PROPOSED"},
        "target_feature_id": {"$ref": "#/$defs/nullableString"},
        "hypothesis": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
