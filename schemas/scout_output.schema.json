{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout_output.schema.json",
  "title": "Scout Output",
  "description": "Deterministic output produced by Scout for a point-in-time market snapshot.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "replay_id",
    "scout_version",
    "snapshot_timestamp",
    "scoring_threshold_pct",
    "candidates"
  ],

  "properties": {
    "replay_id": {
      "type": "string"
    },

    "scout_version": {
      "type": "string"
    },

    "snapshot_timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "scoring_threshold_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },

    "eligible_universe_count": {
      "type": "integer",
      "minimum": 0
    },

    "qualifying_candidate_count": {
      "type": "integer",
      "minimum": 0
    },

    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },

  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "ticker",
        "timestamp",
        "eligible",
        "selected",
        "total_score",
        "maximum_possible_score",
        "score_pct",
        "component_scores",
        "raw_values",
        "guardrails",
        "reason_codes",
        "rejection_reasons"
      ],

      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },

        "timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "eligible": {
          "type": "boolean"
        },

        "selected": {
          "type": "boolean"
        },

        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },

        "total_score": {
          "type": "number",
          "minimum": 0
        },

        "maximum_possible_score": {
          "type": "number",
          "exclusiveMinimum": 0
        },

        "score_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "component_scores": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/componentScore"
          }
        },

        "raw_values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean",
              "null"
            ]
          }
        },

        "guardrails": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/guardrailResult"
          }
        },

        "catalysts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalyst"
          }
        },

        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "rejection_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },

    "componentScore": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "score",
        "maximum_score"
      ],

      "properties": {
        "score": {
          "type": "number",
          "minimum": 0
        },

        "maximum_score": {
          "type": "number",
          "minimum": 0
        },

        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "guardrailResult": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "passed",
        "action"
      ],

      "properties": {
        "passed": {
          "type": "boolean"
        },

        "action": {
          "type": "string",
          "enum": [
            "PASS",
            "PENALIZE",
            "REJECT"
          ]
        },

        "observed_value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },

        "threshold": {
          "type": [
            "number",
            "integer",
            "string",
            "null"
          ]
        },

        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "catalyst": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source",
        "published_timestamp",
        "category"
      ],

      "properties": {
        "source": {
          "type": "string"
        },

        "published_timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "category": {
          "type": "string"
        },

        "reference_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "weight_multiplier": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
