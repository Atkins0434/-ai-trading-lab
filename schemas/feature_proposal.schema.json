{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_proposal.schema.json",
  "title": "Scout Trainer Feature Proposal",
  "description": "Machine-testable proposal generated by Scout Trainer. A proposal is a hypothesis only and cannot modify Production Scout without validation and promotion.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "proposal_id",
    "proposal_date",
    "trainer_version",
    "source_replay_ids",
    "proposal_type",
    "name",
    "description",
    "hypothesis",
    "deterministic_definition",
    "required_source_data",
    "expected_effect",
    "dependencies",
    "conflicts",
    "redundancy_analysis",
    "missing_data_behavior",
    "validation_status",
    "production_mutation_allowed"
  ],

  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },

    "proposal_date": {
      "type": "string",
      "format": "date"
    },

    "first_seen_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },

    "trainer_version": {
      "type": "string"
    },

    "source_replay_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "proposal_type": {
      "type": "string",
      "enum": [
        "NEW_FEATURE",
        "THRESHOLD_CHANGE",
        "WEIGHT_CHANGE",
        "FEATURE_INTERACTION",
        "COMPOSITE_FEATURE",
        "GUARDRAIL_CHANGE"
      ]
    },

    "target_feature_id": {
      "type": [
        "string",
        "null"
      ]
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string",
      "minLength": 1
    },

    "hypothesis": {
      "type": "string",
      "minLength": 1
    },

    "deterministic_definition": {
      "type": "object",
      "description": "Machine-testable definition of the proposed feature or change.",
      "additionalProperties": true
    },

    "required_source_data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "live_data_available": {
      "type": [
        "boolean",
        "null"
      ]
    },

    "expected_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_metric",
        "direction"
      ],
      "properties": {
        "target_metric": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "INCREASE",
            "DECREASE",
            "STABILIZE"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "historical_examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historicalExample"
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "redundancy_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated",
        "potentially_redundant_with"
      ],
      "properties": {
        "evaluated": {
          "type": "boolean"
        },
        "potentially_redundant_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "missing_data_behavior": {
      "type": "string",
      "enum": [
        "SCORE_ZERO",
        "NEUTRAL",
        "REJECT_CANDIDATE",
        "SKIP_FEATURE",
        "NOT_APPLICABLE"
      ]
    },

    "proposed_behavior": {
      "type": "object",
      "additionalProperties": true,
      "description": "Proposed score, weight, threshold, gate, or interaction behavior."
    },

    "validation_status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "COLLECTING_EVIDENCE",
        "READY_FOR_VALIDATION",
        "VALIDATING",
        "REJECTED",
        "ELIGIBLE_FOR_CHALLENGER"
      ]
    },

    "independent_occurrence_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },

    "minimum_required_occurrences": {
      "type": "integer",
      "const": 30
    },

    "production_mutation_allowed": {
      "type": "boolean",
      "const": false
    },

    "version_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/versionEntry"
      }
    }
  },

  "$defs": {
    "historicalExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trading_date",
        "ticker",
        "replay_id"
      ],
      "properties": {
        "trading_date": {
          "type": "string",
          "format": "date"
        },
        "ticker": {
          "type": "string"
        },
        "replay_id": {
          "type": "string"
        },
        "observed_effect": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "version",
        "change"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string"
        },
        "change": {
          "type": "string"
        }
      }
    }
  }
}
