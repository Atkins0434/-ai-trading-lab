{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical_snapshot.schema.json",
  "title": "Historical Snapshot",
  "description": "Point-in-time input supplied to Scout during historical replay. No information created or published after the freeze timestamp is permitted.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "replay_id",
    "trading_date",
    "freeze_timestamp",
    "timezone",
    "universe_version",
    "scout_version",
    "execution_policy_version",
    "feature_registry_version",
    "data_source",
    "universe_mode",
    "universe_manifest_hash",
    "universe_coverage",
    "research_evidence",
    "promotion_eligible",
    "securities"
  ],

  "properties": {
    "replay_id": {
      "type": "string"
    },

    "trading_date": {
      "type": "string",
      "format": "date"
    },

    "freeze_timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "timezone": {
      "const": "America/New_York"
    },

    "universe_version": {
      "type": "string"
    },

    "scout_version": {
      "type": "string"
    },

    "execution_policy_version": {
      "type": "string"
    },

    "feature_registry_version": {
      "type": "string"
    },

    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "feed_version"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "feed_version": {
          "type": "string"
        }
      }
    },

    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "universe_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "universe_coverage": {"enum": ["complete", "incomplete", "fixture"]},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},
    "massive_plan": {"$ref": "#/$defs/massivePlan"},

    "securities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/securitySnapshot"
      }
    }
  },

  "$defs": {
    "massivePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "securitySnapshot": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "ticker",
        "exchange",
        "eligible",
        "eligibility_as_of_timestamp",
        "market_data"
      ],

      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },

        "exchange": {
          "type": "string"
        },

        "eligible": {
          "type": "boolean"
        },

        "eligibility_as_of_timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "eligibility_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "market_cap_usd": {
          "$ref": "#/$defs/marketObservation"
        },

        "market_data": {
          "type": "object",
          "additionalProperties": false,

          "properties": {
            "last_price": {
              "$ref": "#/$defs/marketObservation"
            },

            "bid": {
              "$ref": "#/$defs/marketObservation"
            },

            "ask": {
              "$ref": "#/$defs/marketObservation"
            },

            "order_book_depth_multiple": {
              "$ref": "#/$defs/marketObservation"
            },

            "premarket_volume": {
              "$ref": "#/$defs/marketObservation"
            },

            "premarket_dollar_volume": {
              "$ref": "#/$defs/marketObservation"
            },

            "average_daily_dollar_volume": {
              "$ref": "#/$defs/marketObservation"
            },

            "relative_volume": {
              "$ref": "#/$defs/marketObservation"
            },

            "real_bar_count": {
              "$ref": "#/$defs/marketObservation"
            },

            "real_bar_count_60m": {
              "$ref": "#/$defs/marketObservation"
            },

            "previous_close": {
              "$ref": "#/$defs/marketObservation"
            },

            "average_daily_range_pct": {
              "$ref": "#/$defs/marketObservation"
            },

            "atr_14_usd": {
              "$ref": "#/$defs/marketObservation"
            },

            "atr_lookback_sessions": {
              "$ref": "#/$defs/marketObservation"
            },

            "atr_sessions_used": {
              "$ref": "#/$defs/marketObservation"
            }
          }
        },

        "premarket_bars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bar"
          }
        },

        "news": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/informationEvent"
          }
        },

        "filings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/informationEvent"
          }
        },

        "analyst_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/informationEvent"
          }
        },

        "social_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/informationEvent"
          }
        }
      }
    },

    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "open": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0},
        "low": {"type": "number", "exclusiveMinimum": 0},
        "close": {"type": "number", "exclusiveMinimum": 0},
        "volume": {"type": "number", "minimum": 0},
        "source": {"type": "string"},
        "session": {"type": "string"}
      }
    },

    "marketObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "as_of_timestamp",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "as_of_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "provider_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "informationEvent": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source",
        "published_timestamp"
      ],

      "properties": {
        "source": {
          "type": "string"
        },

        "published_timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "reference_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "category": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
