{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_alpha_batch.schema.json",
  "title": "Research Scout Alpha Batch Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "trading_date", "dataset_partition", "status", "mode", "source",
    "universe_mode", "universe_manifest_hash", "universe_coverage", "research_evidence", "promotion_eligible", "evidence_ineligibility_reasons",
    "requested_tickers", "universe_eligible_tickers", "scored_tickers",
    "universe_rejections", "skipped", "news_backfill_errors", "ticker_queue", "artifacts"
  ],
  "properties": {
    "version": {"const": "research_alpha_batch_v1.1"},
    "trading_date": {"type": "string", "format": "date"},
    "dataset_partition": {"enum": ["DEVELOPMENT", "VALIDATION", "HOLDOUT"]},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "UNSUPPORTED"]},
    "mode": {"const": "RESEARCH_ONLY"},
    "source": {"const": "MASSIVE"},
    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "universe_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "universe_coverage": {"enum": ["complete", "incomplete", "fixture"]},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},
    "evidence_ineligibility_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requested_tickers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "universe_eligible_tickers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scored_tickers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "universe_rejections": {"type": "object", "additionalProperties": {"type": "string"}},
    "skipped": {"type": "object", "additionalProperties": {"type": "string"}},
    "news_backfill_errors": {"type": "object", "additionalProperties": {"type": "string"}},
    "ticker_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "counts", "tasks"],
      "properties": {
        "version": {"const": "replay_queue_v1.0"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["PENDING", "IN_PROGRESS", "COMPLETE", "FAILED"],
          "properties": {
            "PENDING": {"type": "integer", "minimum": 0},
            "IN_PROGRESS": {"type": "integer", "minimum": 0},
            "COMPLETE": {"type": "integer", "minimum": 0},
            "FAILED": {"type": "integer", "minimum": 0}
          }
        },
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universe", "daily_universe_manifest", "scout_output", "pdf_report", "end_of_day_outcome", "benchmark_result", "postmortem", "postmortem_report", "historical_news_backfill", "catalyst_shadow_metrics", "ticker_queue"],
      "properties": {
        "universe": {"type": ["string", "null"]},
        "daily_universe_manifest": {"type": "string"},
        "scout_output": {"type": ["string", "null"]},
        "pdf_report": {"type": ["string", "null"]},
        "end_of_day_outcome": {"type": ["string", "null"]},
        "benchmark_result": {"type": ["string", "null"]},
        "postmortem": {"type": ["string", "null"]},
        "postmortem_report": {"type": ["string", "null"]},
        "historical_news_backfill": {"type": ["string", "null"]},
        "catalyst_shadow_metrics": {"type": ["string", "null"]},
        "ticker_queue": {"type": "string"}
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "trading_date", "ticker", "stage", "partition", "status", "attempts", "last_error", "updated_at"],
      "properties": {
        "task_id": {"type": "string"},
        "trading_date": {"type": "string", "format": "date"},
        "ticker": {"type": ["string", "null"]},
        "stage": {"const": "TICKER_REPLAY"},
        "partition": {"enum": ["DEVELOPMENT", "VALIDATION", "HOLDOUT"]},
        "status": {"enum": ["PENDING", "IN_PROGRESS", "COMPLETE", "FAILED"]},
        "attempts": {"type": "integer", "minimum": 0},
        "last_error": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
