{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_result.schema.json",
  "title": "Benchmark Result",
  "description": "Qualifying-only deterministic same-universe return verdict, separate exploration and combined summaries, plus an independent top-10 diagnostic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replay_id", "trading_date", "universe_version", "universe_mode",
    "universe_manifest_hash", "universe_coverage", "research_evidence",
    "promotion_eligible", "massive_plan", "execution_policy_version", "benchmark_method",
    "benchmark_candidates", "scout_summary", "exploration_summary",
    "combined_summary", "benchmark_summary",
    "return_baselines", "comparison"
  ],
  "properties": {
    "replay_id": {"type": "string"},
    "trading_date": {"type": "string", "format": "date"},
    "universe_version": {"type": "string"},
    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "universe_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "universe_coverage": {"enum": ["complete", "incomplete", "fixture"]},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},
    "massive_plan": {"$ref": "#/$defs/massivePlan"},
    "execution_policy_version": {"type": "string"},
    "benchmark_method": {"const": "RANDOM_DRAW_BASELINE_SAME_UNIVERSE"},
    "benchmark_candidates": {
      "type": "array", "maxItems": 10,
      "items": {"$ref": "#/$defs/benchmarkCandidate"}
    },
    "scout_summary": {"$ref": "#/$defs/performanceSummary"},
    "exploration_summary": {"$ref": "#/$defs/performanceSummary"},
    "combined_summary": {"$ref": "#/$defs/performanceSummary"},
    "benchmark_summary": {"$ref": "#/$defs/performanceSummary"},
    "return_baselines": {"$ref": "#/$defs/returnBaselines"},
    "comparison": {"$ref": "#/$defs/comparison"},
    "cost_model_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "massivePlan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "nullableNumber": {"type": ["number", "null"]},
    "nullableString": {"type": ["string", "null"]},
    "benchmarkCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker", "benchmark_rank", "raw_move_pct",
        "maximum_capturable_move_pct", "day_high_timestamp",
        "universe_eligible", "scout_selected", "scout_selection_basis",
        "scout_trade_executed",
        "scout_realized_return_pct", "scout_exit_reason",
        "scout_exit_timestamp", "fair_simulation_possible",
        "simulation_exclusion_reason", "trade_executed",
        "entry_timestamp", "entry_price", "exit_timestamp", "exit_price",
        "realized_return_pct", "realized_pnl_usd", "capture_ratio",
        "maximum_position_drawdown_pct",
        "exit_reason"
      ],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "benchmark_rank": {"type": "integer", "minimum": 1, "maximum": 10},
        "raw_move_pct": {"type": "number"},
        "maximum_capturable_move_pct": {"type": "number"},
        "day_high_timestamp": {"type": "string", "format": "date-time"},
        "universe_eligible": {"type": "boolean"},
        "scout_selected": {"type": "boolean"},
        "scout_selection_basis": {
          "enum": ["QUALIFYING_THRESHOLD", "EXPLORATION_TOP_K", "REVERSAL_EXPLORATION", "NOT_SELECTED"]
        },
        "scout_trade_executed": {"type": "boolean"},
        "scout_realized_return_pct": {"$ref": "#/$defs/nullableNumber"},
        "scout_exit_reason": {"$ref": "#/$defs/nullableString"},
        "scout_exit_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "fair_simulation_possible": {"type": "boolean"},
        "simulation_exclusion_reason": {"$ref": "#/$defs/nullableString"},
        "trade_executed": {"type": ["boolean", "null"]},
        "entry_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "entry_price": {"$ref": "#/$defs/nullableNumber"},
        "exit_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "exit_price": {"$ref": "#/$defs/nullableNumber"},
        "realized_return_pct": {"$ref": "#/$defs/nullableNumber"},
        "realized_pnl_usd": {"$ref": "#/$defs/nullableNumber"},
        "capture_ratio": {"$ref": "#/$defs/nullableNumber"},
        "maximum_position_drawdown_pct": {"$ref": "#/$defs/nullableNumber"},
        "exit_reason": {"$ref": "#/$defs/nullableString"},
        "net_realized_return_pct": {"type": ["number", "null"]},
        "net_realized_pnl_usd": {"type": ["number", "null"]},
        "net_average_capture_ratio": {"type": ["number", "null"]},
        "gross_realized_pnl_usd": {"type": ["number", "null"]},
        "gross_realized_return_pct": {"type": ["number", "null"]},
        "entry_slippage_usd": {"type": ["number", "null"]},
        "exit_slippage_usd": {"type": ["number", "null"]},
        "commissions_usd": {"type": ["number", "null"]},
        "regulatory_fees_usd": {"type": ["number", "null"]},
        "total_cost_usd": {"type": ["number", "null"]},
        "cost_bps_of_position": {"type": ["number", "null"]},
        "net_capture_ratio": {"type": ["number", "null"]},
        "cost_model_id": {"type": ["string", "null"]},
        "scout_net_realized_return_pct": {"type": ["number", "null"]}
      }
    },
    "performanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count", "trades_executed", "realized_return_pct",
        "realized_pnl_usd", "win_rate_pct", "profit_factor",
        "max_drawdown_pct", "average_capture_ratio"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "trades_executed": {"type": "integer", "minimum": 0},
        "realized_return_pct": {"type": "number"},
        "realized_pnl_usd": {"type": "number"},
        "win_rate_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "profit_factor": {"type": ["number", "null"], "minimum": 0},
        "max_drawdown_pct": {"$ref": "#/$defs/nullableNumber"},
        "average_capture_ratio": {"$ref": "#/$defs/nullableNumber"},
        "net_realized_return_pct": {"type": ["number", "null"]},
        "net_realized_pnl_usd": {"type": ["number", "null"]},
        "net_average_capture_ratio": {"type": ["number", "null"]},
        "gross_realized_pnl_usd": {"type": ["number", "null"]}
      }
    },
    "returnBaselines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "return_basis", "eligible_ticker_count", "eligible_single_position_mean_return_pct",
        "eligible_ticker_mean_realized_pnl_usd", "eligible_basket_expected_return_pct",
        "eligible_basket_expected_pnl_usd", "random_draw_count",
        "random_draw_size", "random_seed",
        "random_draw_mean_realized_return_pct",
        "random_draw_mean_realized_pnl_usd"
      ],
      "properties": {
        "return_basis": {"const": "GROSS_STRATEGY_RETURN_PCT"},
        "eligible_ticker_count": {"type": "integer", "minimum": 0},
        "eligible_single_position_mean_return_pct": {"type": "number"},
        "eligible_ticker_mean_realized_pnl_usd": {"type": "number"},
        "eligible_basket_expected_return_pct": {"type": "number"},
        "eligible_basket_expected_pnl_usd": {"type": "number"},
        "random_draw_count": {"const": 200},
        "random_draw_size": {"type": "integer", "minimum": 0},
        "random_seed": {"type": "integer"},
        "random_draw_mean_realized_return_pct": {"type": "number"},
        "random_draw_mean_realized_pnl_usd": {"type": "number"},
        "net_eligible_single_position_mean_return_pct": {"type": "number"},
        "net_eligible_ticker_mean_realized_pnl_usd": {"type": "number"},
        "net_eligible_basket_expected_return_pct": {"type": "number"},
        "net_eligible_basket_expected_pnl_usd": {"type": "number"},
        "net_random_draw_mean_realized_return_pct": {"type": "number"},
        "net_random_draw_mean_realized_pnl_usd": {"type": "number"},
        "cost_model_id": {"type": "string"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scout_won", "scout_net_realized_return_pct",
        "eligible_ticker_mean_return_difference_pct",
        "random_draw_mean_return_difference_pct", "return_difference_pct",
        "pnl_difference_usd", "top_10_capture_rate_pct",
        "exploration_top_10_capture_rate_pct",
        "combined_top_10_capture_rate_pct", "result_code"
      ],
      "properties": {
        "scout_won": {"type": "boolean"},
        "scout_net_realized_return_pct": {"type": ["number", "null"]},
        "eligible_ticker_mean_return_difference_pct": {"type": "number"},
        "random_draw_mean_return_difference_pct": {"type": "number"},
        "return_difference_pct": {"type": "number"},
        "pnl_difference_usd": {"type": "number"},
        "top_10_capture_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "exploration_top_10_capture_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "combined_top_10_capture_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "result_code": {
          "enum": ["SCOUT_OUTPERFORMED", "SCOUT_TIED", "SCOUT_UNDERPERFORMED"]
        },
        "net_result_code": {"enum": ["SCOUT_OUTPERFORMED", "SCOUT_TIED", "SCOUT_UNDERPERFORMED", null]},
        "gross_result_code": {"enum": ["SCOUT_OUTPERFORMED", "SCOUT_TIED", "SCOUT_UNDERPERFORMED"]},
        "net_scout_won": {"type": ["boolean", "null"]},
        "net_return_difference_pct": {"type": ["number", "null"]},
        "verdict_basis": {"enum": ["GROSS", "NET"]}
      }
    }
  }
}
