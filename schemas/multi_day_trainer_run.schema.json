{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi_day_trainer_run.schema.json",
  "title": "Historical Replay Accelerator Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "mode", "universe_mode", "research_evidence", "promotion_eligible", "trainer_version", "source", "massive_plan", "status", "requested_dates", "requested_tickers", "selection_policy", "dataset_policy", "completed_dates", "failed_dates", "days", "quarantined_days", "aggregate_performance", "hypotheses", "candidate_threshold_reviews", "execution_policy_review", "feature_evidence", "queue", "accelerator", "controls", "artifacts"],
  "properties": {
    "version": {"const": "multi_day_trainer_run_v2.2"},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"const": "RESEARCH_ONLY"},
    "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
    "research_evidence": {"type": "boolean"},
    "promotion_eligible": {"type": "boolean"},
    "trainer_version": {"type": "string"},
    "source": {"type": "string"},
    "massive_plan": {"$ref": "#/$defs/massivePlan"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "UNSUPPORTED"]},
    "requested_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "requested_tickers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "selection_policy": {"type": "object", "additionalProperties": false, "required": ["scoring_threshold_pct_override", "exploration_top_k"], "properties": {"scoring_threshold_pct_override": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "exploration_top_k": {"type": "integer", "minimum": 0, "maximum": 5}}},
    "dataset_policy": {"$ref": "#/$defs/datasetPolicy"},
    "completed_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "failed_dates": {"type": "object", "additionalProperties": {"type": "string"}},
    "days": {"type": "array", "items": {"$ref": "#/$defs/day"}},
    "quarantined_days": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "aggregate_performance": {"$ref": "#/$defs/performance"},
    "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "candidate_threshold_reviews": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/candidateThresholdReview"}},
    "execution_policy_review": {"type": "array", "items": {"$ref": "#/$defs/executionPolicyReview"}},
    "feature_evidence": {"type": "array", "items": {"$ref": "#/$defs/featureEvidence"}},
    "queue": {"$ref": "#/$defs/queue"},
    "accelerator": {"$ref": "#/$defs/accelerator"},
    "controls": {"$ref": "#/$defs/controls"},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["state", "queue", "summary_report"], "properties": {"state": {"type": "string"}, "queue": {"type": "string"}, "summary_report": {"type": "string"}}}
  },
  "$defs": {
    "massivePlan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "rest_calls_per_minute", "history_years", "flat_files"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "rest_calls_per_minute": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "history_years": {"type": "integer", "minimum": 1},
        "flat_files": {"type": "boolean"}
      }
    },
    "partition": {"enum": ["DEVELOPMENT", "VALIDATION", "HOLDOUT"]},
    "datasetPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["split_method", "date_partitions", "allowed_partitions", "holdout_unlocked", "locked_holdout_dates"],
      "properties": {
        "split_method": {"const": "CHRONOLOGICAL_60_20_20"},
        "date_partitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/partition"}},
        "allowed_partitions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/partition"}},
        "holdout_unlocked": {"type": "boolean"},
        "locked_holdout_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}}
      }
    },
    "day": {
      "type": "object", "additionalProperties": false,
      "required": ["trading_date", "partition", "status", "artifact_directory", "scored_ticker_count", "skipped_ticker_count", "eligible_symbol_count", "universe_mode", "massive_plan", "universe_manifest_hash", "universe_coverage", "research_evidence", "promotion_eligible", "unreachable_mover_count", "unreachable_pct", "execution_policy_review_count"],
      "properties": {
        "trading_date": {"type": "string", "format": "date"},
        "partition": {"$ref": "#/$defs/partition"},
        "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "UNSUPPORTED"]},
        "artifact_directory": {"type": "string"},
        "scored_ticker_count": {"type": "integer", "minimum": 0},
        "skipped_ticker_count": {"type": "integer", "minimum": 0},
        "eligible_symbol_count": {"type": "integer", "minimum": 0},
        "universe_mode": {"enum": ["ci_fixture", "historical_research"]},
        "massive_plan": {"$ref": "#/$defs/massivePlan"},
        "universe_manifest_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "universe_coverage": {"enum": ["complete", "incomplete", "fixture"]},
        "research_evidence": {"type": "boolean"},
        "promotion_eligible": {"type": "boolean"},
        "unreachable_mover_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "unreachable_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "execution_policy_review_count": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": ["days_processed", "scout_wins", "ties", "misses", "scout_total_realized_pnl_usd", "exploration_total_realized_pnl_usd", "combined_total_realized_pnl_usd", "benchmark_total_realized_pnl_usd", "scout_average_daily_return_pct", "exploration_average_daily_return_pct", "combined_average_daily_return_pct", "benchmark_average_daily_return_pct", "scout_cumulative_return_pct", "exploration_cumulative_return_pct", "combined_cumulative_return_pct", "benchmark_cumulative_return_pct", "scout_max_drawdown_pct", "exploration_max_drawdown_pct", "combined_max_drawdown_pct", "benchmark_max_drawdown_pct", "scout_daily_return_stddev_pct", "exploration_daily_return_stddev_pct", "combined_daily_return_stddev_pct", "benchmark_daily_return_stddev_pct", "scout_positive_day_rate_pct", "exploration_positive_day_rate_pct", "combined_positive_day_rate_pct", "benchmark_positive_day_rate_pct", "realized_pnl_capture_pct", "average_top_10_capture_rate_pct", "unreachable_mover_count", "unreachable_pct", "execution_policy_review_count"],
      "properties": {
        "days_processed": {"type": "integer", "minimum": 0},
        "scout_wins": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "scout_total_realized_pnl_usd": {"type": "number"},
        "exploration_total_realized_pnl_usd": {"type": "number"},
        "combined_total_realized_pnl_usd": {"type": "number"},
        "benchmark_total_realized_pnl_usd": {"type": "number"},
        "scout_average_daily_return_pct": {"type": "number"},
        "exploration_average_daily_return_pct": {"type": "number"},
        "combined_average_daily_return_pct": {"type": "number"},
        "benchmark_average_daily_return_pct": {"type": "number"},
        "scout_cumulative_return_pct": {"type": "number"},
        "exploration_cumulative_return_pct": {"type": "number"},
        "combined_cumulative_return_pct": {"type": "number"},
        "benchmark_cumulative_return_pct": {"type": "number"},
        "scout_max_drawdown_pct": {"type": "number", "minimum": 0},
        "exploration_max_drawdown_pct": {"type": "number", "minimum": 0},
        "combined_max_drawdown_pct": {"type": "number", "minimum": 0},
        "benchmark_max_drawdown_pct": {"type": "number", "minimum": 0},
        "scout_daily_return_stddev_pct": {"type": "number", "minimum": 0},
        "exploration_daily_return_stddev_pct": {"type": "number", "minimum": 0},
        "combined_daily_return_stddev_pct": {"type": "number", "minimum": 0},
        "benchmark_daily_return_stddev_pct": {"type": "number", "minimum": 0},
        "scout_positive_day_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "exploration_positive_day_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "combined_positive_day_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "benchmark_positive_day_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "realized_pnl_capture_pct": {"type": ["number", "null"]},
        "average_top_10_capture_rate_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "unreachable_mover_count": {"type": "integer", "minimum": 0},
        "unreachable_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "execution_policy_review_count": {"type": "integer", "minimum": 0},
        "net_scout_days_processed": {"type": ["number", "null"]},
        "net_scout_total_realized_pnl_usd": {"type": ["number", "null"]},
        "net_scout_average_daily_return_pct": {"type": ["number", "null"]},
        "net_scout_cumulative_return_pct": {"type": ["number", "null"]},
        "net_exploration_days_processed": {"type": ["number", "null"]},
        "net_exploration_total_realized_pnl_usd": {"type": ["number", "null"]},
        "net_exploration_average_daily_return_pct": {"type": ["number", "null"]},
        "net_exploration_cumulative_return_pct": {"type": ["number", "null"]},
        "net_combined_days_processed": {"type": ["number", "null"]},
        "net_combined_total_realized_pnl_usd": {"type": ["number", "null"]},
        "net_combined_average_daily_return_pct": {"type": ["number", "null"]},
        "net_combined_cumulative_return_pct": {"type": ["number", "null"]},
        "net_benchmark_days_processed": {"type": ["number", "null"]},
        "net_benchmark_total_realized_pnl_usd": {"type": ["number", "null"]},
        "net_benchmark_average_daily_return_pct": {"type": ["number", "null"]},
        "net_benchmark_cumulative_return_pct": {"type": ["number", "null"]},
        "net_scout_wins": {"type": "integer", "minimum": 0},
        "net_ties": {"type": "integer", "minimum": 0},
        "net_misses": {"type": "integer", "minimum": 0},
        "gross_win_to_net_non_win_count": {"type": "integer", "minimum": 0}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis_id", "target_feature_id", "proposal_type", "hypothesis", "independent_occurrence_count", "minimum_required_occurrences", "evidence_requirement_met", "status", "production_mutation_allowed", "evidence"],
      "properties": {
        "hypothesis_id": {"type": "string"}, "target_feature_id": {"type": "string"}, "proposal_type": {"type": "string"}, "hypothesis": {"type": "string"},
        "independent_occurrence_count": {"type": "integer", "minimum": 0}, "minimum_required_occurrences": {"const": 30}, "evidence_requirement_met": {"type": "boolean"},
        "status": {"enum": ["COLLECTING_EVIDENCE", "READY_FOR_VALIDATION"]}, "production_mutation_allowed": {"const": false},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/hypothesisEvidence"}}
      }
    },
    "hypothesisEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["trading_date", "ticker", "partition", "benchmark_rank", "miss_classification", "failure_reason_codes"],
      "properties": {"trading_date": {"type": "string", "format": "date"}, "ticker": {"type": "string"}, "partition": {"const": "DEVELOPMENT"}, "benchmark_rank": {"type": "integer", "minimum": 1, "maximum": 10}, "miss_classification": {"enum": ["VISIBLE_SCORED_LOW", "VISIBLE_GUARDRAIL_REJECTED"]}, "failure_reason_codes": {"type": "array", "items": {"type": "string"}}}
    },
    "candidateThresholdReview": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "low_score_frequency", "missed_ticker_count", "observed_raw_value_min", "observed_raw_value_max"],
      "properties": {
        "metric_id": {"type": "string"},
        "low_score_frequency": {"type": "integer", "minimum": 1},
        "missed_ticker_count": {"type": "integer", "minimum": 1},
        "observed_raw_value_min": {},
        "observed_raw_value_max": {}
      }
    },
    "executionPolicyReview": {
      "type": "object",
      "required": ["trading_date", "partition"],
      "properties": {
        "trading_date": {"type": "string", "format": "date"},
        "partition": {"$ref": "#/$defs/partition"}
      },
      "oneOf": [
        {
          "required": ["ticker", "benchmark_rank", "realized_return_pct", "maximum_capturable_move_pct", "exit_reason", "reason_codes"]
        },
        {
          "required": ["policy_id", "exit_mode", "sizing_mode", "cohort_summaries"]
        }
      ]
    },
    "featureEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "independent_occurrence_count", "validation_occurrence_count", "holdout_occurrence_count", "observed_count", "positive_count", "average_points", "minimum_required_occurrences", "status", "production_mutation_allowed", "evidence"],
      "properties": {
        "metric_id": {"type": "string"}, "independent_occurrence_count": {"type": "integer", "minimum": 0}, "validation_occurrence_count": {"type": "integer", "minimum": 0}, "holdout_occurrence_count": {"type": "integer", "minimum": 0}, "observed_count": {"type": "integer", "minimum": 0}, "positive_count": {"type": "integer", "minimum": 0}, "average_points": {"type": ["number", "null"]}, "minimum_required_occurrences": {"const": 30}, "status": {"enum": ["COLLECTING_EVIDENCE", "READY_FOR_VALIDATION"]}, "production_mutation_allowed": {"const": false},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/featureObservation"}}
      }
    },
    "featureObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["trading_date", "ticker", "partition", "status", "points"],
      "properties": {"trading_date": {"type": "string", "format": "date"}, "ticker": {"type": "string"}, "partition": {"$ref": "#/$defs/partition"}, "status": {"enum": ["OBSERVED", "MISSING"]}, "points": {"type": ["number", "null"], "minimum": 0, "maximum": 4}}
    },
    "queue": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "counts", "tasks"],
      "properties": {
        "version": {"const": "replay_queue_v1.0"},
        "counts": {"type": "object", "additionalProperties": false, "required": ["PENDING", "IN_PROGRESS", "COMPLETE", "FAILED"], "properties": {"PENDING": {"type": "integer", "minimum": 0}, "IN_PROGRESS": {"type": "integer", "minimum": 0}, "COMPLETE": {"type": "integer", "minimum": 0}, "FAILED": {"type": "integer", "minimum": 0}}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "trading_date", "ticker", "stage", "partition", "status", "attempts", "last_error", "updated_at"],
      "properties": {"task_id": {"type": "string"}, "trading_date": {"type": "string", "format": "date"}, "ticker": {"type": ["string", "null"]}, "stage": {"type": "string"}, "partition": {"$ref": "#/$defs/partition"}, "status": {"enum": ["PENDING", "IN_PROGRESS", "COMPLETE", "FAILED"]}, "attempts": {"type": "integer", "minimum": 0}, "last_error": {"type": ["string", "null"]}, "updated_at": {"type": ["string", "null"], "format": "date-time"}}
    },
    "accelerator": {
      "type": "object", "additionalProperties": false,
      "required": ["max_workers", "worker_scope", "date_queue_resumable", "ticker_resume_via_checkpoint_and_cache", "adaptive_rate_limiting", "bounded_retry_handling"],
      "properties": {"max_workers": {"type": "integer", "minimum": 1, "maximum": 8}, "worker_scope": {"const": "TRADING_DATE"}, "date_queue_resumable": {"const": true}, "ticker_resume_via_checkpoint_and_cache": {"const": true}, "adaptive_rate_limiting": {"const": true}, "bounded_retry_handling": {"const": true}}
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["real_money_execution_allowed", "production_mutation_allowed", "automatic_promotion_allowed", "minimum_independent_occurrences", "out_of_sample_validation_required", "blind_holdout_required", "manual_promotion_required"],
      "properties": {"real_money_execution_allowed": {"const": false}, "production_mutation_allowed": {"const": false}, "automatic_promotion_allowed": {"const": false}, "minimum_independent_occurrences": {"const": 30}, "out_of_sample_validation_required": {"const": true}, "blind_holdout_required": {"const": true}, "manual_promotion_required": {"const": true}}
    }
  }
}
