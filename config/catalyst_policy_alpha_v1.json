{
  "policy_version": "catalyst_alpha_v1.0",
  "mode": "SCORED_RESEARCH",
  "freeze_timezone": "America/New_York",
  "freeze_time": "09:15:00",
  "admission": {
    "published_by_freeze_required": true,
    "provider_available_by_freeze_required": true,
    "unknown_provider_availability_action": "ASSUME_AVAILABLE_WITH_LATENCY",
    "syndicated_duplicate_action": "COUNT_ONCE",
    "provider_latency_minutes": 15
  },
  "metrics": [
    {
      "metric_id": "catalyst_quality",
      "production_metric_number": 19,
      "max_points": 4,
      "included_in_alpha_score": true
    },
    {
      "metric_id": "catalyst_verification_confidence",
      "production_metric_number": 20,
      "max_points": 4,
      "included_in_alpha_score": true
    },
    {
      "metric_id": "catalyst_freshness_relevance",
      "production_metric_number": 21,
      "max_points": 4,
      "included_in_alpha_score": true
    }
  ],
  "freshness_hours": {
    "4_points_max": 2,
    "3_points_max": 6,
    "2_points_max": 12,
    "1_point_max": 24
  },
  "safety": {
    "production_score_changes": false,
    "execution_authority": false,
    "dilution_enforcement": "OBSERVE_ONLY"
  },
  "lookback_days": 3,
  "notes": "Massive exposes publish time, not ingestion time, so a 15-minute latency buffer stands in for provider availability. SEC filings are out of scope; SEC_FILING remains defined but is not emitted by this news adapter. Freshness relevance follows the event-type policy, independent of keyword hints. Sentiment is Massive insights only; absent insights yield UNKNOWN.",
  "freshness_relevance": {
    "always_relevant": [
      "EARNINGS",
      "GUIDANCE",
      "FDA_REGULATORY",
      "MERGER_ACQUISITION",
      "CONTRACT_AWARD",
      "PRODUCT",
      "SEC_FILING"
    ],
    "sentiment_dependent": [
      "ANALYST_ACTION",
      "MANAGEMENT",
      "LEGAL_REGULATORY",
      "MACRO_SECTOR",
      "OTHER"
    ],
    "allowed_sentiments": [
      "POSITIVE",
      "MIXED"
    ],
    "never_relevant": [
      "OFFERING_DILUTION"
    ]
  }
}
