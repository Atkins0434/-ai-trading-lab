{
  "historical_market_data": {
    "provider": "TIINGO",
    "adapter": "trainer.providers.tiingo.TiingoClient",
    "credential_environment_variable": "TIINGO_API_TOKEN",
    "feed_version": "tiingo_rest_v1",
    "endpoints": {
      "daily_prices": "/tiingo/daily/{ticker}/prices",
      "intraday_prices": "/iex/{ticker}/prices",
      "news": "/tiingo/news"
    },
    "default_intraday_frequency": "1min",
    "secrets_may_be_logged": false
  },
  "supplemental_historical_market_data": {
    "provider": "MASSIVE",
    "adapter": "trainer.providers.massive.MassiveClient",
    "credential_environment_variable": "MASSIVE_API_KEY",
    "feed_version": "massive_rest_v2_aggs",
    "plan": "DEVELOPER",
    "endpoints": {
      "aggregates": "/v2/aggs/ticker/{ticker}/range/{multiplier}/{timespan}/{from}/{to}",
      "news": "/v2/reference/news"
    },
    "default_intraday_frequency": "1min",
    "secrets_may_be_logged": false
  },
  "bulk_historical_market_data": {
    "provider": "MASSIVE",
    "adapter": "trainer.providers.massive_flatfiles.MassiveFlatFileStore",
    "credential_environment_variables": [
      "MASSIVE_S3_ACCESS_KEY_ID",
      "MASSIVE_S3_SECRET_ACCESS_KEY"
    ],
    "endpoint": "https://files.massive.com",
    "bucket": "flatfiles",
    "datasets": [
      "us_stocks_sip/minute_aggs_v1",
      "us_stocks_sip/day_aggs_v1"
    ],
    "feed_version": "massive_sip_flatfiles_v1",
    "secrets_may_be_logged": false
  }
}
